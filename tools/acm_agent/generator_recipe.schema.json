{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acm.local/schemas/generator_recipe-v1.json",
  "title": "generator_recipe/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"const": "local_templates_v1"},
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "case_kind", "families", "selection", "serialization", "byte_budget"],
      "properties": {
        "profile": {"enum": ["small", "large"]},
        "case_kind": {"enum": ["lower_bound", "upper_bound", "random"]},
        "families": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/family"}},
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "seed_stride"],
          "properties": {
            "policy": {"const": "balanced_round_robin_v1"},
            "seed_stride": {"enum": [1, 5]},
            "schedule": {
              "type": "array", "minItems": 1, "readOnly": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["family_index", "bucket_index"],
                "properties": {
                  "family_index": {"type": "integer", "minimum": 0},
                  "bucket_index": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        },
        "serialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format_id"],
          "properties": {
            "format_id": {"enum": ["list_n", "string_n", "matrix_n_m", "intervals_n", "edge_list_n_m_u_v", "edge_list_n_m_u_v_w"]},
            "bindings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "n": {"$ref": "#/$defs/field_path"}, "m": {"$ref": "#/$defs/field_path"},
                "rows": {"$ref": "#/$defs/field_path"}, "cols": {"$ref": "#/$defs/field_path"},
                "length": {"$ref": "#/$defs/field_path"}, "value": {"$ref": "#/$defs/field_path"},
                "label": {"$ref": "#/$defs/field_path"}
              }
            }
          }
        },
        "byte_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hard_max", "buckets"],
          "properties": {
            "hard_max": {"enum": [100, 33554432]},
            "buckets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bucket"}},
            "active_buckets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bucket"}, "readOnly": true}
          }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "labels", "semantic_goals"],
      "properties": {
        "structure": {"$ref": "#/$defs/structure_ref"},
        "labels": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/label_ref"}},
        "semantic_goals": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"enum": ["connected", "disconnected", "single_vertex", "early_threshold_connects", "last_threshold_connects", "never_connects", "equal_labels", "distinct_labels", "boundary_values", "duplicate_values", "self_loop", "parallel_edges", "acyclic", "one_cycle", "bipartite", "nested", "disjoint", "high_overlap", "endpoint_heavy", "monotone", "permutation", "periodic", "long_runs", "seed_variation", "lower_bound", "upper_bound"]}
        }
      }
    },
    "structure_ref": {
      "type": "object", "additionalProperties": false, "required": ["template_id", "parameters"],
      "properties": {
        "template_id": {"enum": ["array.equal", "array.extreme", "array.few_values", "array.monotone", "array.periodic", "array.permutation", "array.runs", "array.uniform", "graph.bipartite", "graph.components", "graph.connected", "graph.cycle", "graph.parallel_edges", "graph.random_simple", "graph.self_loops", "graph.unicyclic", "interval.disjoint", "interval.endpoint_heavy", "interval.high_overlap", "interval.nested", "interval.points", "interval.random", "matrix.equal", "matrix.extreme", "matrix.few_values", "matrix.monotone", "matrix.periodic", "matrix.permutation", "matrix.runs", "matrix.uniform", "string.equal", "string.extreme", "string.few_chars", "string.monotone", "string.periodic", "string.permutation", "string.runs", "string.uniform", "tree.binary", "tree.caterpillar", "tree.kary", "tree.path", "tree.prim_biased", "tree.prufer", "tree.star"]},
        "parameters": {"$ref": "#/$defs/parameters"}
      }
    },
    "label_ref": {
      "type": "object", "additionalProperties": false, "required": ["template_id", "parameters"],
      "properties": {
        "template_id": {"enum": ["edge_time.layered", "label.distinct", "label.equal", "label.extreme", "label.layered", "label.monotone", "label.permutation", "label.uniform"]},
        "parameters": {"$ref": "#/$defs/parameters"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alphabet": {"type": "string", "minLength": 1}, "pattern": {"type": "string", "minLength": 1}, "policy": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "nondecreasing": {"type": "boolean"}, "distinct": {"type": "boolean"},
        "base": {"type": "integer"}, "cols": {"type": "integer"}, "cols_min": {"type": "integer"}, "cols_max": {"type": "integer"},
        "component_count": {"type": "integer"}, "components": {"type": "integer"}, "count": {"type": "integer"}, "elongation": {"type": "integer"},
        "hi": {"type": "integer"}, "k": {"type": "integer"}, "label_min": {"type": "integer"}, "label_max": {"type": "integer"},
        "length": {"type": "integer"}, "lo": {"type": "integer"}, "m": {"type": "integer"}, "m_min": {"type": "integer"}, "m_max": {"type": "integer"},
        "n": {"type": "integer"}, "n_left": {"type": "integer"}, "n_right": {"type": "integer"}, "n_min": {"type": "integer"}, "n_max": {"type": "integer"},
        "period": {"type": "integer"}, "rows": {"type": "integer"}, "rows_min": {"type": "integer"}, "rows_max": {"type": "integer"},
        "run_count": {"type": "integer"}, "seed": {"type": "integer", "minimum": 0}, "spine": {"type": "integer"}, "spine_length": {"type": "integer"},
        "value": {"type": "integer"}, "value_count": {"type": "integer"}, "value_min": {"type": "integer"}, "value_max": {"type": "integer"}
      }
    },
    "bucket": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2
    },
    "field_path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"}
  }
}
